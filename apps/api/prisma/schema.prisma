generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
  TIMED_OUT
}

enum ExecutionKind {
  RUN
  SUBMIT
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  ERROR
  TIMED_OUT
}

enum DuelStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  username     String             @unique
  passwordHash String?
  googleSub    String?            @unique
  role         UserRole           @default(USER)
  totalXp      Int                @default(0)
  bio          String             @default("")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  submissions  Submission[]
  progress     MissionProgress[]
  xpEvents     XpEvent[]
  bugdex       UserBugDex[]
  learningDays LearningDay[]
  sessions     AuthSession[]
  executions   Execution[]
  following    Follow[]           @relation("FollowFollower")
  followers    Follow[]           @relation("FollowFollowing")
  questClaims  QuestRewardClaim[]
  duelEntries  DuelParticipant[]
  duelWins     DuelRoom[]         @relation("DuelWinner")
  duelRewards  DuelReward[]
}

model QuestRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questKey  String
  periodKey String
  amount    Int
  claimedAt DateTime @default(now())

  @@unique([userId, questKey, periodKey])
  @@index([userId, claimedAt])
}

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Chapter {
  id          String    @id @default(cuid())
  slug        String    @unique
  sortOrder   Int       @unique
  title       String
  description String
  missions    Mission[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BugType {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  missions    Mission[]
  userBugDex  UserBugDex[]
}

model Mission {
  id                String            @id @default(cuid())
  slug              String            @unique
  chapterId         String
  chapter           Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sortOrder         Int
  title             String
  description       String
  language          String            @default("python")
  difficulty        Int
  isBoss            Boolean           @default(false)
  bugTypeId         String
  bugType           BugType           @relation(fields: [bugTypeId], references: [id])
  initialCode       String
  referenceSolution String
  explanation       String
  baseXp            Int
  isPublished       Boolean           @default(false)
  tests             MissionTestCase[]
  hints             Hint[]
  concepts          MissionConcept[]
  submissions       Submission[]
  progress          MissionProgress[]
  xpEvents          XpEvent[]
  executions        Execution[]
  duelRooms         DuelRoom[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([chapterId, sortOrder])
}

model DuelRoom {
  id           String            @id @default(cuid())
  code         String            @unique
  missionId    String
  mission      Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  status       DuelStatus        @default(WAITING)
  winnerId     String?
  winner       User?             @relation("DuelWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  startedAt    DateTime?
  expiresAt    DateTime
  finishedAt   DateTime?
  rewardXp     Int               @default(0)
  participants DuelParticipant[]
  reward       DuelReward?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, expiresAt])
}

model DuelParticipant {
  roomId      String
  userId      String
  room        DuelRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptBase Int       @default(0)
  hintBase    Int       @default(0)
  joinedAt    DateTime  @default(now())
  attempts    Int       @default(0)
  hintUsed    Boolean   @default(false)
  solvedAt    DateTime?

  @@id([roomId, userId])
  @@index([userId, joinedAt])
}

model DuelReward {
  id        String   @id @default(cuid())
  roomId    String   @unique
  room      DuelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model MissionTestCase {
  id             String  @id @default(cuid())
  missionId      String
  mission        Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  sortOrder      Int
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)

  @@unique([missionId, sortOrder])
}

model Hint {
  id        String  @id @default(cuid())
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  level     Int
  content   String

  @@unique([missionId, level])
}

model Concept {
  id       String           @id @default(cuid())
  slug     String           @unique
  name     String
  missions MissionConcept[]
}

model MissionConcept {
  missionId String
  conceptId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([missionId, conceptId])
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId       String
  mission         Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  code            String
  status          SubmissionStatus @default(QUEUED)
  executionTimeMs Int?
  resultJson      Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  execution       Execution?

  @@index([userId])
  @@index([missionId])
}

model Execution {
  id           String          @id
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId    String
  mission      Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  submissionId String?         @unique
  submission   Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  kind         ExecutionKind
  status       ExecutionStatus @default(QUEUED)
  code         String
  customInput  String?
  activeUserId String?         @unique
  attemptCount Int             @default(0)
  enqueuedAt   DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  resultJson   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, enqueuedAt])
  @@index([userId, createdAt])
}

model MissionProgress {
  userId      String
  missionId   String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  attempts    Int       @default(0)
  highestHint Int       @default(0)
  lastCode    String?
  updatedAt   DateTime  @updatedAt

  @@id([userId, missionId])
  @@index([userId, completedAt, updatedAt])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@unique([userId, missionId])
}

model UserBugDex {
  userId            String
  bugTypeId         String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bugType           BugType  @relation(fields: [bugTypeId], references: [id], onDelete: Cascade)
  discoveredCount   Int      @default(1)
  firstDiscoveredAt DateTime @default(now())

  @@id([userId, bugTypeId])
}

model LearningDay {
  userId      String
  date        DateTime @db.Date
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, date])
}
