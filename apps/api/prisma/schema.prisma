generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERROR
  TIMED_OUT
}

enum ExecutionKind {
  RUN
  SUBMIT
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  ERROR
  TIMED_OUT
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  username     String            @unique
  passwordHash String
  role         UserRole          @default(USER)
  totalXp      Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  submissions  Submission[]
  progress     MissionProgress[]
  xpEvents     XpEvent[]
  bugdex       UserBugDex[]
  learningDays LearningDay[]
  sessions     AuthSession[]
  executions   Execution[]
}

model AuthSession {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Chapter {
  id          String    @id @default(cuid())
  slug        String    @unique
  sortOrder   Int       @unique
  title       String
  description String
  missions    Mission[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BugType {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  missions    Mission[]
  userBugDex  UserBugDex[]
}

model Mission {
  id                String            @id @default(cuid())
  slug              String            @unique
  chapterId         String
  chapter           Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sortOrder         Int
  title             String
  description       String
  language          String            @default("python")
  difficulty        Int
  isBoss            Boolean           @default(false)
  bugTypeId         String
  bugType           BugType           @relation(fields: [bugTypeId], references: [id])
  initialCode       String
  referenceSolution String
  explanation       String
  baseXp            Int
  isPublished       Boolean           @default(false)
  tests             MissionTestCase[]
  hints             Hint[]
  concepts          MissionConcept[]
  submissions       Submission[]
  progress          MissionProgress[]
  xpEvents          XpEvent[]
  executions        Execution[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([chapterId, sortOrder])
}

model MissionTestCase {
  id             String  @id @default(cuid())
  missionId      String
  mission        Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  sortOrder      Int
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)

  @@unique([missionId, sortOrder])
}

model Hint {
  id        String  @id @default(cuid())
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  level     Int
  content   String

  @@unique([missionId, level])
}

model Concept {
  id       String           @id @default(cuid())
  slug     String           @unique
  name     String
  missions MissionConcept[]
}

model MissionConcept {
  missionId String
  conceptId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([missionId, conceptId])
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId       String
  mission         Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  code            String
  status          SubmissionStatus @default(QUEUED)
  executionTimeMs Int?
  resultJson      Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  execution       Execution?
}

model Execution {
  id           String          @id
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId    String
  mission      Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  submissionId String?         @unique
  submission   Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  kind         ExecutionKind
  status       ExecutionStatus @default(QUEUED)
  code         String
  customInput  String?
  activeUserId String?         @unique
  attemptCount Int             @default(0)
  enqueuedAt   DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  resultJson   Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, enqueuedAt])
  @@index([userId, createdAt])
}

model MissionProgress {
  userId      String
  missionId   String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  attempts    Int       @default(0)
  highestHint Int       @default(0)
  lastCode    String?
  updatedAt   DateTime  @updatedAt

  @@id([userId, missionId])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@unique([userId, missionId])
}

model UserBugDex {
  userId            String
  bugTypeId         String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bugType           BugType  @relation(fields: [bugTypeId], references: [id], onDelete: Cascade)
  discoveredCount   Int      @default(1)
  firstDiscoveredAt DateTime @default(now())

  @@id([userId, bugTypeId])
}

model LearningDay {
  userId      String
  date        DateTime @db.Date
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@id([userId, date])
}
