FROM node:24-alpine AS dependencies
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/content/package.json packages/content/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
COPY apps/api apps/api
COPY packages/contracts packages/contracts
COPY packages/content packages/content
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build?schema=public
RUN pnpm --filter @bughunter/contracts build \
  && pnpm --filter @bughunter/content build \
  && pnpm --filter @bughunter/api prisma:generate \
  && pnpm --filter @bughunter/api build \
  && pnpm --filter @bughunter/api deploy --prod --legacy /release \
  && SOURCE_CLIENT="$(readlink -f apps/api/node_modules/@prisma/client)" \
  && SOURCE_MODULES="$(dirname "$(dirname "$SOURCE_CLIENT")")" \
  && TARGET_CLIENT="$(readlink -f /release/node_modules/@prisma/client)" \
  && TARGET_MODULES="$(dirname "$(dirname "$TARGET_CLIENT")")" \
  && cp -R "$SOURCE_MODULES/.prisma/." "$TARGET_MODULES/.prisma/"

FROM build AS setup
CMD ["sh", "-c", "apps/api/node_modules/.bin/prisma migrate deploy --schema apps/api/prisma/schema.prisma && apps/api/node_modules/.bin/ts-node-esm apps/api/prisma/seed.ts"]

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /release ./
USER node
EXPOSE 3000
CMD ["node", "dist/main.js"]
